{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/**/*.ts",
    "src/systems/betting.ts",
    "src/systems/player.ts",
    "src/systems/story.ts",
    "src/systems/world.ts",
    "src/systems/upgrade.ts",
    "src/systems/save.ts",
    "src/systems/session.ts",
    "!src/**/*.d.ts"
  ],
  "ignorePatterns": ["dist", "coverage", "reports", "e2e", "docs", "public"],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "timeoutMS": 60000,
  "concurrency": 2
}
