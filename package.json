{
  "name": "house-edge",
  "version": "1.22.2",
  "description": "House Edge — cyberpunk bets in a Brazilian megacity",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123",
    "assets": "python3 tools/build-assets.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43124",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#coverage\" \"#reports\"",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format:playtest-report": "bash tools/format-playtest-report.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "mutation": "stryker run",
    "audit": "npm audit --audit-level=high",
    "prepare": "simple-git-hooks",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e && npm run e2e:prod && npm run mutation"
  },
  "simple-git-hooks": {
    "pre-push": "npm run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "excalibur": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
